PROVIDER_API_KEY=<replace_with_your_provider_api_key>
PROVIDER_BASE_URL="https://models.github.ai/inference"
PROVIDER_MODEL_NAME="openai/gpt-4.1-mini"

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT=nuit-bot-v2

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v18.0
WEBHOOK_VERIFY_TOKEN=nuit_verify_token_stub

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token


# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# https://developers.facebook.com/apps/ → your app → WhatsApp → API Setup
META_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_TOKEN=your-temporary-or-permanent-access-token
META_WEBHOOK_VERIFY_TOKEN=your-custom-random-string   # You choose this value

# ── HubSpot ───────────────────────────────────────────────────────────────────
# https://app.hubspot.com/private-apps → Create private app → Scopes → CRM
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Telegram Bot API ───────────────────────────────────────────────────────────
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token